<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Package visibility (Android 11+): the SU-manager picker enumerates every
         installed app and keeps only the ones that actually ship libksud.so, so a
         fixed <queries> allow-list is no longer enough. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES" />
    <application
        android:label="DirtyFrag"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:theme="@style/Theme.DirtyFrag">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".BootReceiver"
            android:directBootAware="true"
            android:enabled="false"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    <!-- Root from the shade. Root is ephemeral by design, so after every reboot
         the app is two taps away; the tile makes it one, and does it headlessly -
         it calls ExploitRunner directly, so nothing has to come to the
         foreground. exported because SystemUI binds it, gated by the permission
         that binding requires. -->
    <service
        android:name=".RootTileService"
        android:exported="true"
        android:icon="@drawable/ic_tile_root"
        android:label="DirtyFrag"
        android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
        <intent-filter>
            <action android:name="android.service.quicksettings.action.QS_TILE" />
        </intent-filter>
    </service>

    </application>
</manifest>
